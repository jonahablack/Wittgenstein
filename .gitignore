# Experiment outputs under server/scripts stay local (unpublished results):
# only code, READMEs, and requirements files are tracked there.
server/scripts/**/*
!server/scripts/**/
!server/scripts/**/*.py
!server/scripts/**/README.md
!server/scripts/**/requirements.txt
# Vendored third-party repos (re-excluded after the negations above)
server/scripts/**/vendor/

