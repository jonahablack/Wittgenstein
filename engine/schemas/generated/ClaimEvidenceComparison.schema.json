{
  "$defs": {
    "ClaimSupportCandidateStatus": {
      "description": "A programmatic, pre-review classification linking one AnswerClaim to packed\nevidence (schemas/trace.py::AnswerSupportEdge.candidate_support_status) --\ndeliberately not a final correctness verdict and never rendered as \"the answer is\nfalse/faithful/hallucinated\" (docs/review-loop-implementation-plan.md, \"Answer\nclaim extraction\"). Kept as a field separate from the existing, reviewer-facing\n`AnswerSupportEdge.support_status` so a programmatic linking pass can never masquerade\nas a reviewer's judgment.",
      "enum": [
        "supported_candidate",
        "partial_support_candidate",
        "no_support_edge_found",
        "conflict_candidate",
        "unresolved",
        "direct_support_candidate",
        "qualification_required",
        "contradiction_candidate",
        "composite_support_candidate",
        "composite_partial_support_candidate",
        "composite_qualification_required",
        "composite_conflict_candidate",
        "composite_unresolved"
      ],
      "title": "ClaimSupportCandidateStatus",
      "type": "string"
    },
    "ComparisonFieldName": {
      "description": "The 17 structured field types `review/field_extraction.py` attempts to extract\nfrom a claim or candidate passage, per\ndocs/claim-linking-improvement-plan.md \u00a72. Not every field fires on every text --\na field this extractor finds no signal for is `ABSENT` (ComparisonOutcome), not a\nfailure.",
      "enum": [
        "entity",
        "predicate",
        "object_value",
        "polarity",
        "modality",
        "quantification",
        "population_scope",
        "condition",
        "exception",
        "temporal",
        "version",
        "frequency_duration",
        "numeric_value",
        "comparator",
        "unit",
        "jurisdiction",
        "cross_reference"
      ],
      "title": "ComparisonFieldName",
      "type": "string"
    },
    "ComparisonOutcome": {
      "description": "The four-state field-comparison lattice\n(docs/claim-linking-improvement-plan.md \u00a73). ABSENT and UNKNOWN are deliberately\ndistinct: ABSENT means the field is not expressed on at least one side (nothing to\ncompare); UNKNOWN means it may be expressed on both sides but cannot be compared\nwith sufficient confidence (extraction/normalization/scope uncertainty).",
      "enum": [
        "match",
        "mismatch",
        "absent",
        "unknown"
      ],
      "title": "ComparisonOutcome",
      "type": "string"
    },
    "FieldComparison": {
      "additionalProperties": false,
      "description": "One field's four-state comparison outcome between a claim and a candidate.",
      "properties": {
        "claim_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Span"
        },
        "claim_value": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Value"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "explanation": {
          "description": "A bounded, single-field explanation -- never a truth claim.",
          "title": "Explanation",
          "type": "string"
        },
        "extraction_method": {
          "title": "Extraction Method",
          "type": "string"
        },
        "field_name": {
          "$ref": "#/$defs/ComparisonFieldName"
        },
        "mismatch_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/MismatchType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set only when outcome=MISMATCH -- never implies contradiction by itself."
        },
        "normalization_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Method"
        },
        "outcome": {
          "$ref": "#/$defs/ComparisonOutcome"
        },
        "source_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Span"
        },
        "source_value": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Value"
        }
      },
      "required": [
        "field_name",
        "outcome",
        "extraction_method",
        "explanation"
      ],
      "title": "FieldComparison",
      "type": "object"
    },
    "MismatchType": {
      "description": "Classification of a MISMATCH-outcome FieldComparison\n(docs/claim-linking-improvement-plan.md \u00a74). A mismatch is never automatically a\ncontradiction -- that inference is relationship classification's job, under\nstricter conditions (see ClaimSupportCandidateStatus.CONTRADICTION_CANDIDATE).",
      "enum": [
        "frequency_mismatch",
        "duration_mismatch",
        "numeric_mismatch",
        "unit_mismatch",
        "comparator_mismatch",
        "polarity_mismatch",
        "modality_escalation",
        "modality_weakening",
        "scope_broadening",
        "scope_narrowing",
        "condition_omission",
        "exception_omission",
        "temporal_mismatch",
        "version_mismatch",
        "jurisdiction_mismatch",
        "entity_binding_mismatch",
        "predicate_mismatch",
        "value_mismatch"
      ],
      "title": "MismatchType",
      "type": "string"
    },
    "SemanticComparisonResult": {
      "additionalProperties": false,
      "description": "The result of one optional semantic/NLI provider call (or cache hit) comparing\none (claim, passage) pair -- also the cache *value* type\n(docs/claim-linking-improvement-plan.md \u00a78), matching the existing\n`LLMExtractionResult` pattern (`schemas/proposition.py`) rather than inventing a\nsecond cache-record shape.",
      "properties": {
        "cache_key": {
          "title": "Cache Key",
          "type": "string"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "latency_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wall-clock time for this call/lookup -- present even on a cache hit, since local lookup and deserialization still have a nonzero cost; a cache hit is never described as zero latency.",
          "title": "Latency Seconds"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "outcome": {
          "description": "core/enums.py::SemanticComparisonOutcome value, or 'provider_unavailable'.",
          "title": "Outcome",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "parsed_response": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Response"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None when no call was attempted (provider_unavailable).",
          "title": "Provider"
        },
        "raw_response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present only when the caller configured storage.",
          "title": "Raw Response"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "validation_errors": {
          "items": {
            "type": "string"
          },
          "title": "Validation Errors",
          "type": "array"
        }
      },
      "required": [
        "cache_key",
        "schema_version",
        "outcome"
      ],
      "title": "SemanticComparisonResult",
      "type": "object"
    }
  },
  "$id": "https://wittgenstein-rag-reliability/schemas/ClaimEvidenceComparison.schema.json",
  "additionalProperties": false,
  "description": "The full comparison record for one (claim, candidate) pair -- what\n`review/relationship_classification.py` produces and what an `AnswerSupportEdge`\nis derived from. `relationship_status` reuses the existing\n`ClaimSupportCandidateStatus` vocabulary (extended, not duplicated) and is a\ncandidate classification, never a factual adjudication.",
  "properties": {
    "assessment_method": {
      "default": "programmatic_field_comparison",
      "title": "Assessment Method",
      "type": "string"
    },
    "assessment_version": {
      "default": "1",
      "title": "Assessment Version",
      "type": "string"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "comparison_id": {
      "title": "Comparison Id",
      "type": "string"
    },
    "context_item_id": {
      "title": "Context Item Id",
      "type": "string"
    },
    "contradiction_spans": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Contradiction Spans",
      "type": "array"
    },
    "explanation": {
      "description": "Bounded reviewer-facing text -- see relationship_classification.py.",
      "title": "Explanation",
      "type": "string"
    },
    "field_comparisons": {
      "items": {
        "$ref": "#/$defs/FieldComparison"
      },
      "title": "Field Comparisons",
      "type": "array"
    },
    "lexical_features": {
      "additionalProperties": true,
      "description": "e.g. token-overlap ratio -- one signal among many now, not the decision.",
      "title": "Lexical Features",
      "type": "object"
    },
    "mismatch_types": {
      "items": {
        "$ref": "#/$defs/MismatchType"
      },
      "title": "Mismatch Types",
      "type": "array"
    },
    "qualification_spans": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Qualification Spans",
      "type": "array"
    },
    "relationship_status": {
      "$ref": "#/$defs/ClaimSupportCandidateStatus"
    },
    "semantic_features": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticComparisonResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "structural_features": {
      "additionalProperties": true,
      "description": "e.g. entity/predicate alignment booleans.",
      "title": "Structural Features",
      "type": "object"
    },
    "support_spans": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Support Spans",
      "type": "array"
    },
    "uncertainty_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Reason"
    }
  },
  "required": [
    "comparison_id",
    "claim_id",
    "context_item_id",
    "relationship_status",
    "explanation"
  ],
  "title": "ClaimEvidenceComparison",
  "type": "object"
}
