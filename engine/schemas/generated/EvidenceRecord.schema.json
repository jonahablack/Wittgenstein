  "$id": "https://wittgenstein-rag-reliability/schemas/EvidenceRecord.schema.json",
  "additionalProperties": false,
  "description": "One paper/study's support for a mechanism.\n\n`exact_quote` must be verbatim from the primary source. It is never autogenerated\nor paraphrased -- if a quote has not yet been personally verified against the\nprimary source, the seed convention is to leave the literal string\n\"TODO: verify against primary source\" here and set\nverification_status=UNVERIFIED, rather than inventing plausible-sounding text.",
  "properties": {
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "dataset_or_corpus": {
      "title": "Dataset Or Corpus",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/EvidenceDirection",
      "description": "Whether this record supports, refutes, or is mixed/null on its mechanism's causal claim. Required and never inferred -- see docs/registry-governance.md (\"Conflicting studies\"). Contradictory records are kept as separate, independently directioned EvidenceRecords, never merged or averaged into one."
    },
    "effect_size_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effect Size Text"
    },
    "evidence_grade": {
      "$ref": "#/$defs/EvidenceGrade"
    },
    "exact_quote": {
      "title": "Exact Quote",
      "type": "string"
    },
    "experimental_envelope": {
      "$ref": "#/$defs/ExperimentalEnvelope"
    },
    "extraction_date": {
      "format": "date",
      "title": "Extraction Date",
      "type": "string"
    },
    "extraction_reviewer": {
      "title": "Extraction Reviewer",
      "type": "string"
    },
    "failure_mechanism_id": {
      "title": "Failure Mechanism Id",
      "type": "string"
    },
    "full_citation": {
      "title": "Full Citation",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "intervention_or_comparison": {
      "title": "Intervention Or Comparison",
      "type": "string"
    },
    "outcome_metrics": {
      "items": {
        "type": "string"
      },
      "title": "Outcome Metrics",
      "type": "array"
    },
    "peer_review_status": {
      "$ref": "#/$defs/PeerReviewStatus"
    },
    "persistent_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "DOI, arXiv ID, or other persistent identifier.",
      "title": "Persistent Identifier"
    },
    "publication_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None only when the primary source itself is not yet confirmed.",
      "title": "Publication Year"
    },
    "quote_location": {
      "description": "Precise location, e.g. \"Abstract\", \"Table 3\", \"Section 5.2\".",
      "title": "Quote Location",
      "type": "string"
    },
    "quote_type": {
      "$ref": "#/$defs/QuoteType"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "stated_limitations": {
      "title": "Stated Limitations",
      "type": "string"
    },
    "statistical_evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statistical Evidence"
    },
    "study_type": {
      "$ref": "#/$defs/StudyType"
    },
    "task": {
      "title": "Task",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "venue": {
      "title": "Venue",
      "type": "string"
    },
    "verification_status": {
      "$ref": "#/$defs/VerificationStatus"
    }
  },
  "required": [
    "id",
    "failure_mechanism_id",
    "full_citation",
    "title",
    "authors",
    "venue",
    "peer_review_status",
    "exact_quote",
    "quote_location",
    "quote_type",
    "study_type",
    "direction",
    "task",
    "dataset_or_corpus",
    "experimental_envelope",
    "intervention_or_comparison",
    "outcome_metrics",
    "stated_limitations",
    "evidence_grade",
    "extraction_reviewer",
    "extraction_date",
    "verification_status"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
