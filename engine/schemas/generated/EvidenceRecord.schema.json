      "enum": [
        "causal_intervention",
        "controlled_comparison",
        "observational_benchmark",
        "ablation",
        "case_study",
        "survey_or_meta_analysis"
      ],
      "title": "StudyType",
      "type": "string"
    },
    "VerificationStatus": {
      "description": "Whether the exact_quote and metadata on an EvidenceRecord have been checked\nagainst the primary source by a human reviewer.",
      "enum": [
        "verified",
        "unverified",
        "disputed",
        "retracted_source"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
