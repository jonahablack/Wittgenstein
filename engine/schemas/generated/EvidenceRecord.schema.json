{
  "$defs": {
    "EvidenceDirection": {
      "description": "Whether one EvidenceRecord supports, refutes, or is mixed/non-committal on its\nmechanism's causal claim. `NULL` is an explicit value (a record that speaks to the\nmechanism's setting without taking a clear position), distinct from omitting the\nfield entirely -- this field is always required, never left unset.",
      "enum": [
        "supports",
        "refutes",
        "mixed",
        "null"
      ],
      "title": "EvidenceDirection",
      "type": "string"
    },
    "EvidenceGrade": {
      "description": "Grade of a single evidence record, independent of the mechanism's overall status.",
      "enum": [
        "A1_direct_causal_peer_reviewed",
        "A2_strong_comparative_peer_reviewed",
        "B1_mechanistic_transfer_peer_reviewed",
        "B2_component_evidence_peer_reviewed",
        "C_preprint_empirical",
        "D_local_empirical",
        "E_hypothesis"
      ],
      "title": "EvidenceGrade",
      "type": "string"
    },
    "ExperimentalEnvelope": {
      "additionalProperties": false,
      "description": "Experimental preconditions/setting needed to assess transfer.\n\nEvery field is optional at the type level because either side (a study's reported\nsetting, or a manifest-derived setting) may not specify it -- but `None` must be\nread as \"unknown,\" never coerced into a default. See docs/manifest-spec.md.",
