    "EpistemicStatus": {
      "description": "How strongly a failure mechanism's real-world applicability is established.\n\nThis is the single most important guardrail enum in the system: UI-facing code\nmust never present a mechanism as more certain than this status allows.",
      "enum": [
        "externally_established",
        "manifest_conditioned_transfer",
        "trace_integrity_condition",
        "research_hypothesis",
        "locally_validated",
        "unsupported_or_retired"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "FalseReassuranceAnalysis": {
      "additionalProperties": false,
      "description": "Whether the tool made reviewers prematurely comfortable or less likely to\ninvestigate when investigation remained warranted -- tracked as its own named risk,\nnever inferred from a low disagreement rate or a high usefulness score alone. A\ntool that reduces review time but increases false reassurance is not a success --\ndocs/local-validation-protocol.md.",
      "properties": {
        "cases_identified": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cases Identified"
        },
        "definition": {
          "default": "The tool appears to make reviewers prematurely comfortable or less likely to investigate when investigation remains warranted.",
          "title": "Definition",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
