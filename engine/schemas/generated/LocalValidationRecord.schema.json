      "required": [
        "observed"
      ],
      "title": "FalseReassuranceAnalysis",
      "type": "object"
    },
    "LocalValidationStatus": {
      "description": "Lifecycle status of a LocalValidationRecord, independent of the mechanism's\nglobal epistemic_status -- see docs/registry-governance.md (\"Local validation\").",
      "enum": [
        "proposed",
        "in_progress",
        "completed_supports",
        "completed_does_not_support",
        "inconclusive"
      ],
      "title": "LocalValidationStatus",
      "type": "string"
    },
    "PriorityTier": {
      "enum": [
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "PriorityTier",
      "type": "string"
    }
  },
  "$id": "https://wittgenstein-rag-reliability/schemas/LocalValidationRecord.schema.json",
  "additionalProperties": false,
  "description": "A result from this project's own controlled tests or human-review study.\n\nLocal evidence can improve triage priority *in the deployment it was collected\nfrom*, but must never be used to raise a mechanism's global epistemic_status to\nexternally_established -- see docs/registry-governance.md. `external_evidence_status`,\n`local_validation_status`, and `deployment_priority` are kept as three deliberately\nseparate fields (never merged into one \"confidence\") so a local result can move\ntriage priority for this deployment without ever silently touching the mechanism's\nglobal, externally-reviewed status.",
  "properties": {
    "adjudicated_trace_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdjudicatedTraceEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "alert_fatigue_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AlertFatigueEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "autonomy_and_trust_evidence": {
      "anyOf": [
