{
  "$defs": {
    "AdjudicatedTraceEvidence": {
      "additionalProperties": false,
      "description": "Layer A: evidence/factual adjudication -- used only where a defensible\nadjudication target exists. Never required to provide a universal gold label for\nevery task; `applicable=False` is a normal, honest outcome for contested or\nversion-/jurisdiction-dependent material. See `core/enums.py::AdjudicationOutcome`\nfor the per-case outcome vocabulary this layer's rates are computed over.",
      "properties": {
        "adjudication_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What was being adjudicated (claim-level statement, query-level answer, etc.).",
          "title": "Adjudication Target"
        },
        "adjudicator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who adjudicated (role, not necessarily name).",
          "title": "Adjudicator"
        },
        "applicable": {
          "description": "Whether a defensible adjudication target existed for this study/case set at all. False is a normal, honest outcome, not a gap to fill in.",
          "title": "Applicable",
          "type": "boolean"
        },
        "appropriate_unresolved_escalation_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rate at which a genuinely contested/incomplete case was correctly left unresolved or escalated, rather than forced into a false supported/unsupported call.",
          "title": "Appropriate Unresolved Escalation Rate"
        },
        "contradiction_recognition_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contradiction Recognition Rate"
        },
        "disagreement_handling": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How disagreement between adjudicators was represented, not silently resolved.",
          "title": "Disagreement Handling"
        },
        "false_approval_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rate at which reviewers approved a claim that adjudication found unsupported.",
          "title": "False Approval Rate"
        },
        "false_rejection_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rate at which reviewers rejected a claim that adjudication found supported.",
          "title": "False Rejection Rate"
        },
        "governing_source_or_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which source/version was treated as authoritative for this adjudication pass.",
          "title": "Governing Source Or Version"
        },
        "label_granularity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\"claim_level\" or \"query_level\".",
          "title": "Label Granularity"
        },
        "material_issue_definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What counted as a material issue for this study, stated in advance.",
          "title": "Material Issue Definition"
        },
        "material_support_issue_detection_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Support Issue Detection Rate"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "qualification_preservation_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualification Preservation Rate"
        },
        "support_set_completeness_recognition_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Set Completeness Recognition Rate"
        },
        "unresolved_or_contested_case_handling": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Or Contested Case Handling"
        },
        "unsupported_claim_detection_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Claim Detection Rate"
        }
      },
      "required": [
        "applicable"
      ],
      "title": "AdjudicatedTraceEvidence",
      "type": "object"
    },
    "AlertFatigueEvidence": {
      "additionalProperties": false,
      "description": "Alert fatigue and AI burnout, tracked as an explicit evaluation dimension, not an\ninformal motivation only. A low alert volume does not by itself mean low fatigue --\na warning can be low-volume but still opaque, repetitive, or unhelpful; that is why\n`actionable_alert_rate` and the perception measures are reported alongside raw\ncounts, not instead of them.",
      "properties": {
        "actionable_alert_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "alerts_leading_to_meaningful_action_count / alerts_displayed_count. Reported directly (not silently inferred from the counts) so a study can report it even when only aggregate rates, not raw counts, were collected -- but see _actionable_rate_consistent_with_counts for the cross-check when both are given.",
          "title": "Actionable Alert Rate"
        },
        "alerts_dismissed_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alerts Dismissed Count"
        },
        "alerts_displayed_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alerts Displayed Count"
        },
        "alerts_leading_to_meaningful_action_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A meaningful action includes: opening a dependency, inspecting omitted context, checking a competing source, requesting clarification, qualifying the answer, escalating, or marking unresolved.",
          "title": "Alerts Leading To Meaningful Action Count"
        },
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "fatigue_after_block_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fatigue After Block Mean"
        },
        "frustration_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frustration Mean"
        },
        "mental_workload_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mental Workload Mean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "perceived_alert_actionability_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perceived Alert Actionability Mean"
        },
        "perceived_alert_volume_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perceived Alert Volume Mean"
        },
        "perceived_repetitiveness_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perceived Repetitiveness Mean"
        },
        "repeated_warning_annoyance_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeated Warning Annoyance Mean"
        },
        "unnecessary_escalation_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Escalations that increased review burden without improving reviewer-perceived understanding or usefulness -- a distinct risk from a mechanism simply having a low actionable_alert_rate.",
          "title": "Unnecessary Escalation Count"
        }
      },
      "title": "AlertFatigueEvidence",
      "type": "object"
    },
